# Copy this file to .env.local (gitignored — never commit real values) and fill in.
# plan.md §10 — Local Development Setup

# MongoDB, running locally: `docker run -d --name portfolio-mongo -p 127.0.0.1:27017:27017 mongo:7`
# or a native `mongod` install. MUST NOT be exposed beyond localhost (gaurdrail.md §6).
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# NextAuth — generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
